# WikiSpeedrun environment variables. Copy to .env (gitignored) and fill in.
# Everything here is optional — the app runs without any of it, just with the
# corresponding feature disabled.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Real-user analytics: Postgres event store ───────────────────────────────
# The unblockable source of truth. Railway provisions this automatically; locally
# point it at any Postgres. If unset, server-side event logging is disabled
# (gameplay is unaffected). The `events` table + indexes are created on boot.
DATABASE_URL=postgres://user:pass@host:5432/dbname
# TLS override for the DB connection. Auto-detected (off for *.railway.internal /
# localhost, on otherwise); set 'disable' or 'require' to force it.
# PGSSL=require

# ── Real-user analytics: GA4 Measurement Protocol (server-side) ─────────────
# Recovers ad-blocked users inside GA4 by sending key events server-side, for
# everyone. If either is unset, the GA4 mirror is disabled (Postgres still logs).
# Secret: GA4 Admin > Data Streams > [your stream] > Measurement Protocol API secrets.
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your_mp_api_secret

# ── Optional: Discord crash alerts ──────────────────────────────────────────
# A genuine crash (uncaught exception / unhandled rejection) and relayed client
# errors ping this webhook. Unset = no alerts.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Optional: gameplay / debug flags ────────────────────────────────────────
# ENFORCE_MOVE_LEGALITY=true
# DEBUG_BACKLINKS=true
